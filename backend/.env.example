SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Resend (preferred method - add your API key from https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Receiver(s): comma-separated list of emails that will receive contact form submissions
RECEIVER_EMAIL=you@example.com,colleague@example.com
